{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "hackathon-ito-app",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-28",

  "assets": {
    "directory": "../../front/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "containers": [
    {
      "class_name": "Backend",
      "image": "../docker/back.Dockerfile",
      "image_build_context": "../../back",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "Backend"
      }
    ]
  },

  "exports": {
    "Backend": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "r2_buckets": [
    {
      "binding": "DRAWINGS",
      "bucket_name": "ito-drawing"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ito-db",
      "database_id": "5b7b72e9-69ee-4a6b-bfb6-98c7327b1658",
      "migrations_dir": "migrations"
    }
  ],


  "observability": {
    "enabled": true
  }
}