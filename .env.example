# Add development environment variables here.

# ---- 判定エンジン（back/）----
# Claude API キー（未設定なら LLM なしで幾何スコアのみ返す）
ANTHROPIC_API_KEY=
# AI Gateway を使う場合のみ: https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/anthropic
ANTHROPIC_BASE_URL=
# 既定 claude-haiku-5-5。発表デモでは claude-opus-5-5
LLM_MODEL=claude-haiku-5-5
# コメント（AI②）だけ別モデルにする場合
COMMENT_MODEL=
# 1日あたりの Claude 呼び出し回数の上限（超えたら AI なしで返す）
LLM_DAILY_LIMIT=3000
# 1 にすると /api/dev/samples（検証サンプル保存）が有効になる
DEV=0
