# Add development environment variables here.
# このファイルをコピーして .env を作る（.env は Git に入らない）。

# ---- 分析（back/src/judge）。くわしくは back/src/judge/settings.py の先頭 ----
# Claude の API キー（秘密の値）。無ければ AI を使わずに動く
ANTHROPIC_API_KEY=
# Cloudflare AI Gateway を通すときだけ: https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/anthropic
ANTHROPIC_BASE_URL=
# 判定とメッセージに使うモデル（既定 claude-haiku-5-5）
LLM_MODEL=claude-haiku-5-5
# メッセージだけ別のモデルにするとき
COMMENT_MODEL=
# 1 日に Claude を呼ぶ回数の上限（1 回の確定で 2〜3 回）。超えたら AI なしで返す
LLM_DAILY_LIMIT=3000
# 1 回の確定で AI に使ってよい合計の秒数（フロントは 15 秒で打ち切る）
JUDGE_AI_BUDGET_S=11
# 本番で公開しているサイトの URL。AI がくつしたの画像（/socks/*.webp）を読むのに使う
SOCK_IMAGE_BASE_URL=
# 1 にすると、開発用の確認ページ（/api/dev/playground）と判定データの記録が有効になる
DEV=0
